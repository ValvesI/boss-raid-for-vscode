{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Boss Raid Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/extension/boss-raid"
      ],
      "outFiles": [
        "${workspaceFolder}/extension/boss-raid/out/**/*.js"
      ],
      "preLaunchTask": "Compile Boss Raid Extension"
    }
  ]
}
