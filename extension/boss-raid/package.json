{
  "name": "boss-raid",
  "displayName": "Boss Raid",
  "description": "",
  "version": "0.0.4",
  "engines": {
    "vscode": "^1.132.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:bossRaid.dashboard"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "bossRaid",
          "title": "Boss Raid",
          "icon": "resources/boss-raid.svg"
        }
      ]
    },
    "views": {
      "bossRaid": [
        {
          "type": "webview",
          "id": "bossRaid.dashboard",
          "name": "Jogar"
        }
      ]
    },
    "commands": [
      {
        "command": "boss-raid.start",
        "title": "Boss Raid: Criar Raid"
      },
      {
        "command": "boss-raid.join",
        "title": "Boss Raid: Entrar em Raid"
      },
      {
        "command": "boss-raid.attack",
        "title": "Boss Raid: Enviar Ataque de Teste"
      }
    ],
    "configuration": {
      "title": "Boss Raid",
      "properties": {
        "bossRaid.serverUrl": {
          "type": "string",
          "default": "https://boss-raid-for-vscode.onrender.com",
          "description": "Endereço do servidor multiplayer da raid."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "1.125.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "dependencies": {
    "socket.io-client": "^4.8.3"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
